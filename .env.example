# Copy to .env and fill in. Providers without a key are skipped in the chain.
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# GitHub personal access token (no scopes needed, public data only).
# Without it, live star counts are limited to 60 repos/hour and the rest
# fall back to the count reported by Hugging Face.
GITHUB_TOKEN=

# Fallback order
FA_LLM_CHAIN=gemini,groq,deepseek

# Models (override if a model is retired)
FA_GEMINI_MODEL=gemini-3.5-flash
FA_GROQ_MODEL=openai/gpt-oss-120b
FA_DEEPSEEK_MODEL=deepseek-chat

# Free-tier friendly limits; raise these on paid tiers
FA_GEMINI_RPM=15
FA_GROQ_RPM=30
FA_GROQ_TPM=8000
FA_GROQ_MAX_INPUT_TOKENS=6000

FA_LLM_CONCURRENCY=16

# Google Sheets push (optional; see README "Google Sheets"). The key file stays out of git (secrets/ is ignored).
FA_GOOGLE_SHEET_ID=
FA_GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
FA_LOG_LEVEL=INFO
FA_LOG_JSON=false
